# Signing identities for personal APKs (keystores, raw keys, v4 signatures).
*.keystore
*.jks
*.p12
*.pk8
*.pem
*.idsig

# Game-derived media and RAM dumps written outside local/ by older or manual
# runs. All audio here comes from the ROM; authored PNGs may live elsewhere,
# so PNG ignores stay scoped to the repository root and tool directories.
*.wav
*.ram
events.jsonl
/*.png
/tools/**/*.png
__pycache__/
*.py[cod]
.venv/
.DS_Store
